# Copy to .env and fill in. Never commit .env.

# Required. Create one at https://console.x.ai/
XAI_API_KEY=

# Model id. grok-4.7 is the current flagship. grok-3 still works if you want the old one.
GROK_MODEL=grok-4.7
GROK_MAX_TOKENS=500

# IRC
IRC_SERVER=irc.efnet.org
IRC_PORT=6697
IRC_USE_TLS=1
IRC_NICK=GrokBot
IRC_ALT_NICK=GrokBot_
IRC_USER=grokbot
IRC_REALNAME=Grok IRC Bot by foctober
IRC_CHANNEL=#crackheads,#otherchan

# Flood control. EFnet is picky; leave these alone unless you know the server.
FLOOD_DELAY=0.7
MAX_MSG_PER_SEC=2
MAX_LINE_BYTES=400
MAX_REPLY_LINES=6

# Cache and short channel memory
CACHE_SIZE=80
CACHE_SIMILARITY=0.88
HISTORY_TURNS=4

LOG_FILE=grok_irc_bot.log
LOG_LEVEL=INFO
